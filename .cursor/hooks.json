{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".agents/hooks/hook.sh mark cursor",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": ".agents/hooks/hook.sh stop cursor",
        "timeout": 120,
        "loop_limit": 2
      }
    ]
  }
}
