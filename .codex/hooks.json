{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.agents/hooks/hook.sh\" mark codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.agents/hooks/hook.sh\" stop codex",
            "statusMessage": "Rebuilding docs/",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
